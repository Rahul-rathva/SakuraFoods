# Copy this file to ".env" in the same folder, then replace the placeholders.
# Never commit the real .env file.

# MongoDB Atlas connection string
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/blossomfoods
MONGO_URL=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/blossomfoods

# OpenAI API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional. Defaults to 3000 if omitted.
PORT=3000
